# Copy to .env and edit. Relative paths are resolved against this file.

# Where Marquee keeps its settings, cache and API key.
CONFIG=./config

# The torrent folder, as the machine running this container sees it. It has to hold
# the same files qBittorrent writes to.
DOWNLOADS=/srv/downloads

# The categorised library. Leave it pointing anywhere if you send the library to a
# console over SMB, FTP or SFTP instead -- then this volume goes unused.
LIBRARY=/srv/roms/mame

# The user the files should belong to: `id -u` and `id -g`.
PUID=1000
PGID=1000
TZ=Europe/Istanbul

PORT=8585
